{
  "name": "mfd-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS practice operating system for Indian Mutual Fund Distributors",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:raw": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:prod": "npm run build && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:rbac": "node scripts/check-require-cap.mjs",
