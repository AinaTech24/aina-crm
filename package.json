{
  "name": "mfd-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS practice operating system for Indian Mutual Fund Distributors",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:raw": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:prod": "npm run build && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:rbac": "node scripts/check-require-cap.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:migrations": "node scripts/check-migration-dups.mjs",
    "check:colors": "node scripts/check-hardcoded-colors.mjs",
    "check:asany": "node scripts/check-as-any.mjs",
    "check:mathimports": "node scripts/check-math-imports.mjs",
    "test:unit": "vitest run",
    "check:calc": "tsx scripts/check-calc-math.ts",
    "check:finance": "tsx scripts/check-finance-math.ts",
    "check:spine": "tsx scripts/check-spine.ts",
    "test": "tsx scripts/check-finance-math.ts && tsx scripts/check-calc-math.ts && tsx scripts/check-spine.ts && node scripts/check-migration-dups.mjs && vitest run",
    "db:provision-app-role": "node scripts/provision-app-role.mjs",
    "migrate:all": "tsx scripts/migrate-all.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "worker": "tsx watch src/workers/index.ts",
    "worker:prod": "tsx src/workers/index.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:prod": "tsx scripts/seed-prod.ts",
    "backfill:default-recipes": "tsx scripts/backfill-default-recipes.ts",
    "backfill:lead-scores": "tsx scripts/backfill-lead-scores.ts",
    "backfill:investor-health": "tsx scripts/backfill-investor-health.ts",
    "backfill:family-health": "tsx scripts/backfill-family-health.ts",
    "backfill:goal-progress": "tsx scripts/backfill-goal-progress.ts",
    "backfill:active-sip": "tsx scripts/backfill-active-sip-amount.ts",
    "backfill:aum": "tsx scripts/backfill-aum.ts",
    "recipes:enable": "tsx scripts/enable-recipes.ts",
    "refresh:nav": "tsx scripts/refresh-nav.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@react-email/components": "^1.0.0",
    "@react-email/render": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@xyflow/react": "^12.0.0",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.0.0",
    "cron-parser": "^5.0.0",
    "date-fns": "^4.0.0",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^1.3.5",
    "ioredis": "^5.0.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.0.0",
    "mailparser": "^3.9.9",
    "next": "^15.0.0",
    "nodemailer": "^8.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^3.0.0",
    "react-hook-form": "^7.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.0.0",
    "tailwind-merge": "^2.0.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.6.2",
    "uuid": "^11.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
