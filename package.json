    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "worker": "tsx watch src/workers/index.ts",
    "worker:prod": "tsx src/workers/index.ts",
    "seed": "tsx src/db/seed.ts"
  },
