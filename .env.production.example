# =============================================================================
# MFD Growth OS — PRODUCTION env reference (AWS)
# =============================================================================
# Copy real values into AWS Secrets Manager / SSM (NOT into the repo).
# Legend:  [REQUIRED] must set   [GEN] Claude generates a strong random value
#          [OPT] feature-specific, safe to leave unset to start
#
# NOTE: NEXT_PUBLIC_* are baked into the client bundle at BUILD time → they are
# passed as docker build args, the rest are injected at run time.
# -----------------------------------------------------------------------------

# ---- Core --------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Raise the V8 heap ceiling on small (≤4 GB) single-box hosts so a large RTA
# file import (CAMS R9 / KFintech master, ~10 MB zip → big spreadsheet, parsed
# synchronously in the web process) doesn't OOM-crash the whole web server.
# Backed by swap; size to ~75% of host RAM+swap headroom. Leave unset on big hosts.
NODE_OPTIONS=--max-old-space-size=3072

# ---- Database (RDS PostgreSQL 16) -------------------------------------------
# App connects via the NON-superuser RLS role in prod; superuser URL only for
# migrations/admin. ALLOW_SUPERUSER_DB MUST be 0 in prod.
DATABASE_URL=postgres://mfd_app:CHANGE_ME@<rds-endpoint>:5432/mfd?sslmode=require   # [REQUIRED]
APP_DATABASE_URL=postgres://mfd_app:CHANGE_ME@<rds-endpoint>:5432/mfd?sslmode=require # [REQUIRED] (RLS app role)
ALLOW_SUPERUSER_DB=0
ALLOW_SYSTEM_TX=1                 # workers/webhooks need cross-tenant system context
PG_POOL_MAX=10

# ---- Redis (ElastiCache 7) ---------------------------------------------------
REDIS_URL=rediss://<elasticache-endpoint>:6379   # [REQUIRED]

# ---- Auth & crypto -----------------------------------------------------------
NEXTAUTH_SECRET=                  # [GEN] 32+ byte random
ENCRYPTION_KEY=                   # [GEN] 32-byte key (field-level encryption)
INTERNAL_API_TOKEN=               # [GEN] guards /api/internal/* cron endpoints
HEALTH_TOKEN=                     # [GEN] guards /api/health/workers
# NO_AUTH must be UNSET in prod (demo bypass is disabled when NODE_ENV=production)

# ---- Public URLs (set to your domain) ---------------------------------------
APP_URL=https://app.yourfirm.com            # [REQUIRED]
APP_BASE_URL=https://app.yourfirm.com       # [REQUIRED]
NEXT_PUBLIC_APP_URL=https://app.yourfirm.com   # [REQUIRED] build-arg
NEXT_PUBLIC_SITE_URL=https://app.yourfirm.com  # [REQUIRED] build-arg

# ---- File storage (S3 + CloudFront) -----------------------------------------
S3_REGION=ap-south-1                         # [REQUIRED]
S3_BUCKET=mfd-uploads-prod                   # [REQUIRED]
S3_ACCESS_KEY_ID=                            # [REQUIRED] (or use IAM task role)
S3_SECRET_ACCESS_KEY=                        # [REQUIRED] (or use IAM task role)
NEXT_PUBLIC_S3_PUBLIC_URL=https://cdn.yourfirm.com  # [REQUIRED] build-arg (CloudFront)

# ---- AI provider -------------------------------------------------------------
# The provider, model names, and API key are best set in Aina Admin → AI & Models
# (stored ENCRYPTED in the DB, switchable live). These env vars are only a
# FALLBACK used when nothing is saved there. AI_PROVIDER picks which to use.
AI_PROVIDER=google                 # google | anthropic  (what the app uses if no DB config)

# Google Gemini (default) — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                    # [REQUIRED unless set in Aina Admin]
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=                 # [OPT] used when AI_PROVIDER=anthropic
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-5

# ---- Email (Resend) ----------------------------------------------------------
# [REQUIRED] — without it, team-invite and password-reset emails are NEVER sent
# (onboarding silently breaks). The app logs an error per skipped email in prod.
RESEND_API_KEY=                   # [REQUIRED]
RESEND_WEBHOOK_SECRET=            # [OPT] delivery webhooks (Svix; whsec_… — replay-protected)
EMAIL_FROM_TRANSACTIONAL=no-reply@yourfirm.com   # [REQUIRED]
EMAIL_FROM_MARKETING=hello@yourfirm.com          # [REQUIRED]

# ---- WhatsApp (Wapi — own WhatsApp Business API, beckend.ainatech.in) --------
WAINA_API_KEY=                    # [OPT] wpk_… — enable WhatsApp sends
WAINA_BASE_URL=https://beckend.ainatech.in/api
WAINA_DEFAULT_LANGUAGE=en_US
WAINA_WEBHOOK_SECRET=             # [REQUIRED IN PROD] echoed by Wapi on inbound webhooks;
                                  # if unset in production the inbound webhook FAILS CLOSED (503)
                                  # so forged inbound messages / consent-revocation can't get through
WAINA_WEBHOOK_VERIFY_TOKEN=       # [OPT] Meta GET verify handshake

# ---- SMS (MSG91, DLT) --------------------------------------------------------
MSG91_AUTH_KEY=                   # [OPT]
MSG91_SENDER_ID=                  # [OPT]

# ---- Deferred / optional integrations ---------------------------------------
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET= / RAZORPAY_WEBHOOK_SECRET=  (billing)
# KYC_PROVIDER= / KYC_API_URL= / KYC_API_KEY=                          (KYC)
# BSE_STAR_MEMBER_CODE= / BSE_STAR_PASSKEY= / BSE_STAR_MODE=           (order routing)
# AMFI_NAVALL_URL=  MARKET_INDEX_URL=  ERROR_WEBHOOK_URL=
