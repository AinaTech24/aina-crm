# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next-preview/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env
.env
.env*.local
.env.local
.env.development.local
.env.production.local
# real production / staging secret files (the *.example templates ARE committed)
.env.production
.env.staging
# env BACKUPS / pg-preview dumps — these hold real credentials. The rules above
# miss them: `.env*.local` only matches names ENDING in `.local`, so a file like
# `.env.local.bak.pgpreview` slipped through and was staged by `git add -A`.
.env.bak*
.env*.bak*
*.pgpreview

# deploy tarballs built by the scp deploy flow (multi-MB build artefacts)
*.tgz
*.tar.gz
# stray 68 MB unreadable blob at the repo root (no read permission) — it aborts
# `git add -A` outright. Not a source file; ignore rather than commit.
/.zip

# terraform — never commit state or real var values (keep *.example + lock file)
infra/**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
/drizzle/migrations/meta/_journal.json.bak

# editor
.vscode/
.idea/
*.swp
.claude/

# local scratch / one-off scripts
/scratch/

# logs
logs/
*.log

# Local scratch/debug dumps
_tmp_*

# 206 MB DB schema dump — far over GitHub's 100 MB file limit, and a build
# artefact rather than source. Keep it local.
schema.zip
