#!/usr/bin/env bash
# Blocks a push whose commits would fail CI. Verifies the exact commit being
# pushed (scripts/pre-push-verify.sh), so a failing check never reaches GitHub
# and a push to main never starts a deploy that is already doomed.
#
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
# Deleting a branch and tag pushes are not verified.
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  case "$local_ref" in refs/tags/*) continue;; esac
  base="origin/main"
  git rev-parse -q --verify "$base" >/dev/null || base="$(git rev-list --max-parents=0 "$local_sha" | tail -1)"
  bash "$(cd "$(dirname "$0")/.." && pwd)/scripts/pre-push-verify.sh" "$local_sha" "$base" || status=1
done
exit $status
