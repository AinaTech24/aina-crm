{
  "expo": {
    "name": "Aina CRM",
    "slug": "growth-os-mobile",
    "scheme": "growthos",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.ainatech.growthos"
    },
    "android": {
      "package": "in.ainatech.growthos",
      "permissions": [
        "android.permission.READ_CALL_LOG",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aina CRM uses your photos to attach client KYC documents.",
          "cameraPermission": "Aina CRM uses your camera to capture client KYC documents."
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aina CRM records where a client visit or attendance punch happened, so your firm has an accurate field record.",
          "locationWhenInUsePermission": "Aina CRM records where a client visit or attendance punch happened, so your firm has an accurate field record.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "@sentry/react-native",
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f496da1-7cc7-4891-9fb7-ca03a97dd8f0"
      },
      "callLogEnabled": true
    },
    "owner": "ainatech-services-llp",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/6f496da1-7cc7-4891-9fb7-ca03a97dd8f0"
    }
  }
}
