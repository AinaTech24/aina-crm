+import { sql } from "drizzle-orm";
+import type { SessionUser } from "@/lib/auth/session";
+import { investorScopeSql } from "@/lib/investors/access";
+
+/**
+ * The client record a minor's guardian link may point at (investors.guardian_investor_id).
+ * The link copies the guardian's risk profile onto the minor (migration 0234) and
+ * the minor's pages name the guardian, so it may only point at a live, adult
+ * client the user can already see, and a typed PAN links only when exactly one
+ * such client holds it. Anything else is left unlinked, never guessed.
+ */
+export async function guardianCandidate(
+  tx: any,
+  session: SessionUser,
+  by: { id?: string | null; pan?: string | null; excludeId?: string },
+): Promise<string | null> {
+  if (!by.id && !by.pan) return null;
+  let scope;
+  try { scope = await investorScopeSql(tx, session, "g"); } catch { return null; }
+  const rows = (await tx.execute(sql`
+    SELECT g.id::text AS id FROM investors g
+     WHERE g.tenant_id = ${session.tenantId}::uuid
+       AND ${by.id ? sql`g.id = ${by.id}::uuid` : sql`g.pan = ${by.pan}`}
+       ${by.excludeId ? sql`AND g.id <> ${by.excludeId}::uuid` : sql``}
+       AND g.deleted_at IS NULL AND g.merged_into_id IS NULL
+       AND coalesce(g.investor_category, '') <> 'minor'
+       AND ${scope}
+     LIMIT 2`)).rows as Array<{ id: string }>;
+  return rows.length === 1 ? rows[0].id : null;
+}
