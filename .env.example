# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-32-byte-random-string

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mfd

# --- Encryption (AES-256-GCM key for per-tenant integration secrets, e.g. the
#     WAina/WhatsApp key saved in Settings → Integrations). 32 bytes as hex.
#     Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     MUST be set in production — a dev fallback is used only when unset. ---
ENCRYPTION_KEY=

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=whsec_xxx
EMAIL_FROM_TRANSACTIONAL="Aina CRM <no-reply@ainatech.in>"
EMAIL_FROM_MARKETING="Your Firm <mail@mfd.example.com>"

# --- Mailbox OAuth (optional: "Connect Gmail / Outlook" without app passwords) ---
# Until these are set, the OAuth buttons are hidden and users connect via SMTP/IMAP.
# Register a redirect URI of EXACTLY:
#   {APP_ORIGIN}/api/settings/integrations/mailbox/oauth/google/callback
#   {APP_ORIGIN}/api/settings/integrations/mailbox/oauth/microsoft/callback
# (or set OAUTH_REDIRECT_BASE to force the origin used to build that URI).
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web app):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Entra (Azure AD) → App registrations → Web platform + client secret:
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
# Optional override of the origin used in the redirect URI (e.g. https://app.yourfirm.com):
OAUTH_REDIRECT_BASE=

# --- WhatsApp (Wapi — the operator's own WhatsApp Business API) ---
# https://beckend.ainatech.in — auth header `x-api-key: wpk_…`.
# WAINA_BASE_URL is the `/api` base (the adapter appends the documented paths).
WAINA_API_KEY=wpk_...
WAINA_BASE_URL=https://beckend.ainatech.in/api
WAINA_DEFAULT_LANGUAGE=en_US
# Optional: shared secret the Wapi platform echoes on inbound webhook calls
# (x-webhook-secret / x-api-key) + Meta verify token for the GET handshake.
WAINA_WEBHOOK_SECRET=
WAINA_WEBHOOK_VERIFY_TOKEN=

# --- SMS (MSG91) ---
MSG91_AUTH_KEY=xxx
MSG91_SENDER_ID=MFDPLT
MSG91_ROUTE=4

# --- Anthropic (AI assistant + compliance deep-check) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL_REASONING=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# --- Storage (S3) ---
S3_REGION=ap-south-1
S3_BUCKET=mfd-platform-docs
S3_ACCESS_KEY_ID=AKIA6FCM33YKCZNQDYHY
S3_SECRET_ACCESS_KEY=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

# --- BSE Star MF (per tenant, configured in DB; these are platform defaults for dev) ---
BSE_STAR_MEMBER_CODE=
BSE_STAR_USER_ID=
BSE_STAR_PASSWORD=
BSE_STAR_BASE_URL=https://bsestarmfdemo.bseindia.com

# --- Worker concurrency knobs ---
WORKFLOW_RUNNER_CONCURRENCY=10
OUTBOX_POLLER_INTERVAL_MS=200
SEGMENT_MATERIALIZER_CONCURRENCY=4
